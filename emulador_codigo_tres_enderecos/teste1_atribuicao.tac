# Teste 1 - Atribuicao simples e operacoes aritmeticas
# Cobre: atribuicao, +, -, *, /, negacao unaria (-x), print
#
# Equivalente em alto nivel:
# a = 10
# b = 3
# soma = a + b
# sub = a - b
# mul = a * b
# div = a / b
# negA = -a
# print soma, sub, mul, div, negA

a = 10
b = 3
soma = a + b
sub = a - b
mul = a * b
div = a / b
negA = -a
print "soma = ", soma
print "sub = ", sub
print "mul = ", mul
print "div = ", div
print "negA = ", negA

# Saida esperada:
# soma = 13
# sub = 7
# mul = 30
# div = 3
# negA = -10